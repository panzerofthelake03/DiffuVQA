# Çalıştırın (PowerShell, venv aktif): python - <<'PY'
import json, glob, sys
files = glob.glob("datasets/*.jsonl") + glob.glob("datasets/*/*.jsonl")
for f in files:
    miss = 0
    total = 0
    with open(f, 'r', encoding='utf-8') as fh:
        for i,line in enumerate(fh,1):
            total +=1
            try:
                obj = json.loads(line)
            except Exception as e:
                print(f"{f}:{i} JSON error {e}")
                continue
            if 'qid' not in obj:
                miss +=1
                if miss <= 5:
                    print(f"Missing qid: {f} line {i} keys={list(obj.keys())}")
    if miss:
        print(f"{f}: {miss}/{total} missing qid")
# PY